# Camera & Model Settings
CAMERA_SOURCE=http://<YOUR_PHONE_IP>:8080/video
YOLO_MODEL_PATH=yolov8n.pt

# Gemini AI Settings
# Note: Ensure you use an active model like gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash
GOOGLE_API_KEY=your_google_api_key_here

# Email Alert Settings
ALERT_EMAIL_SENDER=your_sender_email@gmail.com
ALERT_EMAIL_RECEIVER=your_receiver_email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_PASSWORD=your_16_digit_app_password_here

# Video Settings
INCIDENT_VIDEO_FPS=15

# Database Settings
DATABASE_URL=mysql+pymysql://db_username:db_password@localhost:3306/securemind_db